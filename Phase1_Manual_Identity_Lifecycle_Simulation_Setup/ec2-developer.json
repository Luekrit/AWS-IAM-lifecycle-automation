{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDescribeInApprovedRegion",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-southeast-2" }
      }
    },
    {
      "Sid": "LaunchSmallInstancesTaggedWithOwnDepartment",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:*:instance/*",
        "arn:aws:ec2:ap-southeast-2:*:volume/*"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestTag/department": "${aws:PrincipalTag/department}" },
        "StringEqualsIfExists": { "ec2:InstanceType": ["t3.micro", "t3.small"] }
      }
    },
    {
      "Sid": "LaunchUsingExistingNetworkAndImages",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-southeast-2::image/*",
        "arn:aws:ec2:ap-southeast-2:*:subnet/*",
        "arn:aws:ec2:ap-southeast-2:*:network-interface/*",
        "arn:aws:ec2:ap-southeast-2:*:security-group/*",
        "arn:aws:ec2:ap-southeast-2:*:key-pair/*"
      ]
    },
    {
      "Sid": "TagOnlyAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:*:instance/*",
        "arn:aws:ec2:ap-southeast-2:*:volume/*"
      ],
      "Condition": {
        "StringEquals": { "ec2:CreateAction": "RunInstances" }
      }
    },
    {
      "Sid": "ManageOnlyOwnDepartmentInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:*:instance/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/department": "${aws:PrincipalTag/department}" }
      }
    }
  ]
}
