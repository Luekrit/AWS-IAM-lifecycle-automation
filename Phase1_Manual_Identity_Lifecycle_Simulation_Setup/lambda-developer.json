{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAndAccountInfo",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions",
        "lambda:GetAccountSettings",
        "lambda:ListLayers"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageOwnDepartmentFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:InvokeFunction",
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:ListVersionsByFunction",
        "lambda:ListAliases",
        "lambda:TagResource",
        "lambda:DeleteFunction"
      ],
      "Resource": "arn:aws:lambda:ap-southeast-2:*:function:${aws:PrincipalTag/department}-*"
    },
    {
      "Sid": "PassOnlyApprovedExecutionRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/lambda-exec/*",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" }
      }
    },
    {
      "Sid": "ReadOwnFunctionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-2:*:log-group:/aws/lambda/${aws:PrincipalTag/department}-*"
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "DenyPublicFunctionExposure",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "lambda:FunctionUrlAuthType": "NONE" }
      }
    },
    {
      "Sid": "DenyResourcePolicyChanges",
      "Effect": "Deny",
      "Action": [
        "lambda:AddPermission",
        "lambda:RemovePermission"
      ],
      "Resource": "*"
    }
  ]
}
