{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyOwnDepartmentBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::iamlab-${aws:PrincipalTag/department}-*"
    },
    {
      "Sid": "ReadObjectsInOwnDepartmentBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::iamlab-${aws:PrincipalTag/department}-*/*"
    }
  ]
}
